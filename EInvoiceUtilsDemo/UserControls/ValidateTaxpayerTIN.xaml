<UserControl x:Class="SBS.Core.EInvoiceUtilsDemo.UserControls.ValidateTaxpayerTIN"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:c="clr-namespace:SBS.Core.EInvoiceUtilsDemo.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Style="{StaticResource Input}">
                <TextBlock Text="TIN" FontSize="16"/>
                <TextBox Text="{Binding ValidateTaxpayerTINInput, Mode=TwoWay}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,15,0,15" Style="{StaticResource Input}">
                <TextBlock Text="ID Type" FontSize="16"/>
                <ComboBox SelectedIndex="{Binding ValidateTaxpayerIDTypeInput, Mode=TwoWay}"
                          Margin="0,3,0,0"
                          Style="{StaticResource DropdownSelection}">
                    <ComboBoxItem Content="NRIC"/>
                    <ComboBoxItem Content="PASSPORT"/>
                    <ComboBoxItem Content="BRN"/>
                    <ComboBoxItem Content="ARMY"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource Input}">
                <TextBlock Text="ID" FontSize="16"/>
                <TextBox Text="{Binding ValidateTaxpayerIDInput, Mode=TwoWay}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2"
                Content="Validate"
                Style="{StaticResource PrimaryBtn}"
                Command="{Binding ValidateTaxpayerTINCommand}"/>
    </Grid>
</UserControl>
