<UserControl x:Class="SBS.Core.EInvoiceUtilsDemo.UserControls.GetDocumentDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Style="{StaticResource Input}">
                <TextBlock Text="UUID" FontSize="16"/>
                <TextBox Text="{Binding GetDocumentDetailsUUIDInput, Mode=TwoWay}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1"
                Content="Retrieve"
                Style="{StaticResource PrimaryBtn}"
                Margin="0,15,0,0"
                Command="{Binding GetDocumentDetailsCommand}"/>
    </Grid>
</UserControl>
