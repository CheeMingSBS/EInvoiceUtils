<UserControl x:Class="SBS.Core.EInvoiceUtilsDemo.UserControls.CreateDocument"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Grid.Row="0" Margin="0,0,10,0">
                <Expander Header="Document Header" Style="{StaticResource Collapsible}">
                    <StackPanel Margin="0,5,0,10" Style="{StaticResource Input}">
                        <TextBlock Text="Document ID" FontSize="16"/>
                        <TextBox Margin="0,3,0,0" Text="INV-12345"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Supplier" Style="{StaticResource Collapsible}">
                    <StackPanel>
                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Name" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="Test"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="TIN" FontSize="16"/>
                            <TextBox Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="ID Type" FontSize="16"/>
                            <ComboBox SelectedIndex="0" Margin="0,3,0,0" Style="{StaticResource DropdownSelection}">
                                <ComboBoxItem Content="NRIC"/>
                                <ComboBoxItem Content="PASSPORT"/>
                                <ComboBoxItem Content="BRN"/>
                                <ComboBoxItem Content="ARMY"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="ID" FontSize="16"/>
                            <TextBox Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Business Description" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="Carpark Operator"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Address Line 1" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="X Unit 07-06, Vertical Tower A"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Address Line 2" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="No. 8 Jalan Kerinchi, Bangsar South"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="City Name" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="Kuala Lumpur"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Postal Zone" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="50490"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="State" FontSize="16"/>
                            <ComboBox SelectedIndex="13" Margin="0,3,0,0" Style="{StaticResource DropdownSelection}">
                                <ComboBoxItem Content="Johor"/>
                                <ComboBoxItem Content="Kedah"/>
                                <ComboBoxItem Content="Kelantan"/>
                                <ComboBoxItem Content="Melaka"/>
                                <ComboBoxItem Content="Negeri Sembilan"/>
                                <ComboBoxItem Content="Pahang"/>
                                <ComboBoxItem Content="Pulau Pinang"/>
                                <ComboBoxItem Content="Perak"/>
                                <ComboBoxItem Content="Perlis"/>
                                <ComboBoxItem Content="Selangor"/>
                                <ComboBoxItem Content="Terengganu"/>
                                <ComboBoxItem Content="Sabah"/>
                                <ComboBoxItem Content="Sarawak"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Kuala Lumpur"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Labuan"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Putrajaya"/>
                                <ComboBoxItem Content="Not Applicable"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Email" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="test@test.com"/>
                        </StackPanel>

                        <StackPanel Margin="0,5,0,10" Style="{StaticResource Input}">
                            <TextBlock Text="Contact Number" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="01234567890"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="Customer" Style="{StaticResource Collapsible}">
                    <StackPanel>
                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Name" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="Test"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="TIN" FontSize="16"/>
                            <TextBox Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="ID Type" FontSize="16"/>
                            <ComboBox SelectedIndex="0" Margin="0,3,0,0" Style="{StaticResource DropdownSelection}">
                                <ComboBoxItem Content="NRIC"/>
                                <ComboBoxItem Content="PASSPORT"/>
                                <ComboBoxItem Content="BRN"/>
                                <ComboBoxItem Content="ARMY"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="ID" FontSize="16"/>
                            <TextBox Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Address Line 1" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="X Unit 07-06, Vertical Tower A"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Address Line 2" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="No. 8 Jalan Kerinchi, Bangsar South"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="City Name" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="Kuala Lumpur"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Postal Zone" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="50490"/>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="State" FontSize="16"/>
                            <ComboBox SelectedIndex="13" Margin="0,3,0,0" Style="{StaticResource DropdownSelection}">
                                <ComboBoxItem Content="Johor"/>
                                <ComboBoxItem Content="Kedah"/>
                                <ComboBoxItem Content="Kelantan"/>
                                <ComboBoxItem Content="Melaka"/>
                                <ComboBoxItem Content="Negeri Sembilan"/>
                                <ComboBoxItem Content="Pahang"/>
                                <ComboBoxItem Content="Pulau Pinang"/>
                                <ComboBoxItem Content="Perak"/>
                                <ComboBoxItem Content="Perlis"/>
                                <ComboBoxItem Content="Selangor"/>
                                <ComboBoxItem Content="Terengganu"/>
                                <ComboBoxItem Content="Sabah"/>
                                <ComboBoxItem Content="Sarawak"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Kuala Lumpur"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Labuan"/>
                                <ComboBoxItem Content="Wilayah Persekutuan Putrajaya"/>
                                <ComboBoxItem Content="Not Applicable"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,5" Style="{StaticResource Input}">
                            <TextBlock Text="Email" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="test@test.com"/>
                        </StackPanel>

                        <StackPanel Margin="0,5,0,10" Style="{StaticResource Input}">
                            <TextBlock Text="Contact Number" FontSize="16"/>
                            <TextBox Margin="0,3,0,0" Text="01234567890"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <Expander Header="Invoice Line Items" Style="{StaticResource Collapsible}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,5,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0"
                                               Text="Line Item 1"
                                               TextDecorations="Underline"
                                               FontFamily="Geist"
                                               FontWeight="Medium"
                                               FontSize="16"/>

                                    <Button Grid.Column="1"
                                            Content="Remove"
                                            Style="{StaticResource FailureBtn}"/>
                                </Grid>

                                <StackPanel Margin="0,0,0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="ID" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="INV-12345_1"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Classification Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="004"/>
                                </StackPanel>
                            
                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Description" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="E_1234567_1234"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Unit Price Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="5.66"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Taxable Amount" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="5.66"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Unit Price Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,10" Text="0.34"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Line Item 2"
                                               TextDecorations="Underline"
                                               FontFamily="Geist"
                                               FontWeight="Medium"
                                               FontSize="16"/>

                                    <Button Grid.Column="1"
                                            Content="Remove"
                                            Style="{StaticResource FailureBtn}"/>
                                </Grid>

                                <StackPanel Margin="0,0,0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="ID" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="INV-12345_1"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Classification Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="004"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Description" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="E_1234567_1234"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Unit Price Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="5.66"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Taxable Amount" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="5.66"/>
                                </StackPanel>

                                <StackPanel Margin="0,5" Style="{StaticResource Input}">
                                    <TextBlock Text="Unit Price Code" FontSize="16"/>
                                    <TextBox Margin="0,3,0,0" Text="0.34"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Add"
                                Style="{StaticResource SuccessBtn}"/>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="Create"
                Style="{StaticResource PrimaryBtn}"
                Margin="0,15,0,0"/>
    </Grid>
</UserControl>
