<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RoundedSection" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="WhiteSmoke"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Geist"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="Background" Value="#417EEA"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="CornflowerBlue"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Input" TargetType="StackPanel">
        <Style.Resources>
            <!--Label-->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#0D0D0D"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <!--Input Text-->
            <Style TargetType="TextBox">
                <Setter Property="BorderBrush" Value="#0D0D0D"/>
                <Setter Property="Background" Value="WhiteSmoke"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Foreground" Value="#0D0D0D"/>
                <Setter Property="FontFamily" Value="Geist"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!--Password Input Text-->
            <Style TargetType="PasswordBox">
                <Setter Property="BorderBrush" Value="#0D0D0D"/>
                <Setter Property="Background" Value="WhiteSmoke"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Foreground" Value="#0D0D0D"/>
                <Setter Property="FontFamily" Value="Geist"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            CornerRadius="6">
                                <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="#FF7EB4EA"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="#FF569DE5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="2"/>
                    </Style>
                </Style.Resources>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="DropdownSelection" TargetType="ComboBox">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid FocusVisualStyle="{x:Null}">
                        <ToggleButton Name="toggleBtn"
                                      Content="{TemplateBinding Text}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="#0D0D0D"/>
                                    <Setter Property="FontFamily" Value="Geist"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Name="border"
                                                        BorderBrush="#0D0D0D"
                                                        Background="WhiteSmoke"
                                                        BorderThickness="1"
                                                        Padding="8"
                                                        CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter Grid.Column="0"/>
                                                        <Path Name="arrow"
                                                              Grid.Column="1"
                                                              Width="15"
                                                              Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"
                                                              Fill="#0D0D0D"
                                                              VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" TargetName="border" Value="#FF7EB4EA"/>
                                                        <Setter Property="Fill" TargetName="arrow" Value="#FF7EB4EA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" TargetName="border" Value="#FF569DE5"/>
                                                        <Setter Property="Fill" TargetName="arrow" Value="#FF7EB4EA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Popup Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=toggleBtn}"
                               IsOpen="{Binding ElementName=toggleBtn, Path=IsChecked, Mode=OneWay}"
                               StaysOpen="False"
                               Width="{Binding ElementName=toggleBtn, Path=ActualWidth, Mode=OneWay}">
                            <Border Background="WhiteSmoke"
                                    BorderBrush="#0D0D0D"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="WhiteSmoke"/>
                <Setter Property="Foreground" Value="#0D0D0D"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Geist"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="#0D0D0D"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="Collapsible" TargetType="Expander">
        <Setter Property="ExpandDirection" Value="Down"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Geist"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="SuccessBtn" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Geist"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="Background" Value="SeaGreen"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="MediumSeaGreen"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FailureBtn" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Geist"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="Background" Value="#be3939"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#be6060"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>