<Window x:Class="EInvoiceUtilsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo"
        xmlns:uc="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
        mc:Ignorable="d"
        Title="EInvoiceUtilsDemo" MinHeight="600" MinWidth="900" Background="#E8E8E8">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <uc:Login Visibility="Hidden"/>

        <Grid Margin="20">
            <Grid.Resources>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Grid.Column="0"
                               Text="EInvoiceUtils Demo"
                               FontFamily="Geist"
                               FontWeight="SemiBold"
                               FontSize="28"
                               Foreground="#0D0D0D"
                               VerticalAlignment="Bottom"
                               Padding="3,0,3,0"/>

                    <Border Grid.Column="0"
                            Background="SeaGreen"
                            CornerRadius="6"
                            Padding="6"
                            VerticalAlignment="Top"
                            Style="{StaticResource RoundedSection}">
                        <TextBlock Text="Taxpayer"
                                   FontFamily="Geist"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="WhiteSmoke"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="Logout" Style="{StaticResource FailureBtn}"/>
            </Grid>

            <uc:Navbar Grid.Row="1"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RoundedSection}" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Title"
                                   FontFamily="Geist"
                                   FontSize="24 "
                                   FontWeight="Medium"
                                   Foreground="#0D0D0D"
                                   TextDecorations="Underline"/>

                        <!--<uc:ValidateTaxpayerTIN Grid.Row="2"/>-->
                        <!--<uc:GetSubmission Grid.Row="2"/>-->
                        <!--<uc:GetDocumentDetails Grid.Row="2"/>-->
                        <!--<uc:SubmitDocuments Grid.Row="2"/>-->
                        <uc:CreateDocument Grid.Row="2"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1">
                    <Border Grid.Column="1" Style="{StaticResource RoundedSection}">
                        <RichTextBox Name="Output"
                                     BorderBrush="Transparent"
                                     Background="WhiteSmoke"
                                     FontFamily="Geist"
                                     FontWeight="Medium"
                                     FontSize="14"
                                     IsReadOnly="True"/>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
