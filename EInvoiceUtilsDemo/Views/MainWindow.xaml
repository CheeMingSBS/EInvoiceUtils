<Window x:Class="EInvoiceUtilsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo"
        xmlns:uc="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
        xmlns:c="clr-namespace:SBS.Core.EInvoiceUtilsDemo.Converters"
        mc:Ignorable="d"
        Title="EInvoiceUtilsDemo" MinHeight="600" MinWidth="900" Background="#E8E8E8">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:MainUIConverter x:Key ="MainUIConverter"/>
            <c:IsNullConverter x:Key ="IsNullConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <uc:Login>
            <uc:Login.Style>
                <Style TargetType="{x:Type uc:Login}">
                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoggedInAs, Converter={StaticResource IsNullConverter}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uc:Login.Style>
        </uc:Login>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="20"/>
                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoggedInAs, Converter={StaticResource IsNullConverter}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Grid.Column="0"
                               Text="EInvoiceUtils Demo"
                               FontFamily="{StaticResource Geist}"
                               FontWeight="SemiBold"
                               FontSize="28"
                               Foreground="#0D0D0D"
                               VerticalAlignment="Bottom"
                               Padding="3,0,3,0"/>

                    <Border Grid.Column="0"
                            Background="SeaGreen"
                            CornerRadius="6"
                            Padding="6"
                            VerticalAlignment="Top"
                            Style="{StaticResource RoundedSection}">
                        <TextBlock Text="{Binding LoggedInAs}"
                                   FontFamily="{StaticResource Geist}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="WhiteSmoke"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Logout"
                        Style="{StaticResource FailureBtn}"
                        Command="{Binding LogoutCommand}"/>
            </Grid>

            <uc:Navbar Grid.Row="1"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RoundedSection}" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding SelectedMode, Mode=OneWay}"
                                   FontFamily="{StaticResource Geist}"
                                   FontSize="24 "
                                   FontWeight="Medium"
                                   Foreground="#0D0D0D"
                                   TextDecorations="Underline"/>

                        <uc:ValidateTaxpayerTIN Grid.Row="2">
                            <uc:ValidateTaxpayerTIN.Style>
                                <Style TargetType="{x:Type uc:ValidateTaxpayerTIN}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Validate Taxpayer TIN">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:ValidateTaxpayerTIN.Style>
                        </uc:ValidateTaxpayerTIN>

                        <uc:GetSubmission Grid.Row="2">
                            <uc:GetSubmission.Style>
                                <Style TargetType="{x:Type uc:GetSubmission}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Get Submission">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:GetSubmission.Style>
                        </uc:GetSubmission>

                        <uc:GetDocumentDetails Grid.Row="2">
                            <uc:GetDocumentDetails.Style>
                                <Style TargetType="{x:Type uc:GetDocumentDetails}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Get Document Details">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:GetDocumentDetails.Style>
                        </uc:GetDocumentDetails>

                        <uc:SubmitDocuments Grid.Row="2">
                            <uc:SubmitDocuments.Style>
                                <Style TargetType="{x:Type uc:SubmitDocuments}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Submit Documents">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:SubmitDocuments.Style>
                        </uc:SubmitDocuments>

                        <uc:CreateDocument Grid.Row="2">
                            <uc:CreateDocument.Style>
                                <Style TargetType="{x:Type uc:CreateDocument}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Create Document">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:CreateDocument.Style>
                        </uc:CreateDocument>
                    </Grid>
                </Border>

                <Border Grid.Column="1">
                    <Border Grid.Column="1" Style="{StaticResource RoundedSection}">
                        <!-- TODO: Should really use a TextBlock here...? -->
                        <TextBox BorderBrush="Transparent"
                                 Background="WhiteSmoke"
                                 FontFamily="{StaticResource Geist}"
                                 FontWeight="Medium"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="WrapWithOverflow"
                                 Text="{Binding Output}"/>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
