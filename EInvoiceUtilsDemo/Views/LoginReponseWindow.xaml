<Window x:Class="EInvoiceUtilsDemo.LoginResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SBS.Core.EInvoiceUtilsDemo"
        xmlns:uc="clr-namespace:SBS.Core.EInvoiceUtilsDemo.UserControls"
        xmlns:c="clr-namespace:SBS.Core.EInvoiceUtilsDemo.Converters"
        mc:Ignorable="d"
        Title="EInvoiceUtilsDemo" Height="400" Width="400" Background="#E8E8E8"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Geist.xaml"/>
                <ResourceDictionary Source="/Resources/General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource RoundedSection}">
        <!-- TODO: Should really use a TextBlock here...? -->
        <TextBox BorderBrush="Transparent"
                 Background="WhiteSmoke"
                 FontFamily="{StaticResource Geist}"
                 FontWeight="Medium"
                 FontSize="14"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 Text="{Binding Response}"/>
    </Border>
</Window>
