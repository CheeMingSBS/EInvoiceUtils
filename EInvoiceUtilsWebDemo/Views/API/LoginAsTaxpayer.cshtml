@{
    ViewData["Title"] = "Login As Taxpayer";
}

<h1>Login As Taxpayer</h1>
<div class="d-flex flex-column gap-4 h-100">
    <form id="form">
        <div class="d-flex flex-column gap-2">
            <div>
                <label for="clientId">Client ID</label>
                <input type="text" class="form-control w-50" id="clientId" value="8f2c48da-fac9-460b-b2fa-7a724a175962" />
            </div>
            <div>
                <label for="clientSecret">Client Secret</label>
                <input type="text" class="form-control w-50" id="clientSecret" value="0a594eff-e4b1-415b-b5dc-2bc9d9161ea0" />
            </div>
            <div>
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </div>
    </form>
    <div class="flex-grow-1">
        <textarea class="form-control h-100" readonly id="result"></textarea>
    </div>
</div>

<script>
    const form = document.querySelector("#form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const response = await fetch('@Url.Action("LoginAsTaxpayer")', {
            method: "POST",
            body: JSON.stringify({
                clientId: document.querySelector("#clientId").value,
                clientSecret: document.querySelector("#clientSecret").value
            }),
            headers: {
                "Content-Type": "application/json"
            }
        });

        if (response.status == 200)
            document.querySelector("#result").value = JSON.stringify(await response.json(), null, 2);
    });
</script>