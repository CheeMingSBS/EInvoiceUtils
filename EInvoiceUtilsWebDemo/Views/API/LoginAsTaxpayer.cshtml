@{
    ViewData["Title"] = "Login As Taxpayer";
}

<h1>Login As Taxpayer</h1>
<div class="flex-grow-1 d-flex gap-4">
    <div class="flex-grow-1 d-flex flex-column gap-4">
        <form id="form">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label for="clientId">Client ID</label>
                    <input type="text" class="form-control" id="clientId" value="8f2c48da-fac9-460b-b2fa-7a724a175962" />
                </div>
                <div>
                    <label for="clientSecret">Client Secret</label>
                    <input type="text" class="form-control" id="clientSecret" value="0a594eff-e4b1-415b-b5dc-2bc9d9161ea0" />
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <div id="result" class="fw-bold"></div>
                </div>
            </div>
        </form>
    </div>
    <div class="flex-grow-1 d-flex flex-column">
        <textarea class="form-control flex-grow-1" readonly id="output"></textarea>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $("#form").on("submit", (e) => {
        e.preventDefault();

        $.ajax({
            url: '@Url.Action("LoginAsTaxpayer")',
            method: "POST",
            data: {
                clientId: $("#clientId").val(),
                clientSecret: $("#clientSecret").val()
            },
            success: function (data, textStatus, jqXHR) {
                $("#output").val(JSON.stringify(data, null, 2));

                if (jqXHR.status == 200)
                    $("#result").text("Success! ✅")
                else
                    $("#result").text("Failed! ❌")
            }
        });
    });
</script>