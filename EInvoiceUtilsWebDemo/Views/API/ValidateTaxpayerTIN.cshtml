@{
    ViewData["Title"] = "Validate Taxpayer TIN";
}

<h1>Validate Taxpayer TIN</h1>
<div class="flex-grow-1 d-flex gap-4">
    <div class="flex-grow-1 d-flex flex-column gap-4">
        <form id="form">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label for="tin">TIN</label>
                    <input type="text" class="form-control" id="tin" value="IG28566784100" />
                </div>
                <div>
                    <label for="id-type">ID Type</label>
                    <select class="form-select" id="id-type">
                        <option value="NRIC" selected>NRIC</option>
                        <option value="BRN">BRN</option>
                        <option value="ARMY">ARMY</option>
                        <option value="PASSPORT">PASSPORT</option>
                    </select>
                </div>
                <div>
                    <label for="id">ID</label>
                    <input type="text" class="form-control" id="id" value="980427145943" />
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <button type="submit" class="btn btn-primary">Validate</button>
                    <div id="result" class="fw-bold"></div>
                </div>
            </div>
        </form>
    </div>
    <div class="flex-grow-1 d-flex flex-column">
        <textarea class="form-control flex-grow-1" readonly id="output"></textarea>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $("#form").on("submit", (e) => {
        e.preventDefault();

        $.ajax({
            url: '@Url.Action("ValidateTaxpayerTIN")',
            method: "POST",
            data: {
                idType: $("#id-type").val(),
                tin: $("#tin").val(),
                id: $("#id").val()
            },
            success: function(data, textStatus, jqXHR) {
                $("#output").val(JSON.stringify(data, null, 2));

                if (jqXHR.status == 200)
                    $("#result").text("Success! ✅")
                else
                    $("#result").text("Failed! ❌")
            }
        });
    });
</script>