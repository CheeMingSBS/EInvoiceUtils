@{
    ViewData["Title"] = "Validate Taxpayer TIN";
}

<h1>Validate Taxpayer TIN</h1>
<div class="d-flex flex-column gap-4 h-100">
    <form id="form">
        <div class="d-flex flex-column gap-2">
            <div>
                <label for="tin">TIN</label>
                <input type="text" class="form-control w-50" id="tin" value="IG28566784100" />
            </div>
            <div>
                <label for="nric">NRIC</label>
                <input type="text" class="form-control w-50" id="nric" value="980427145943" />
            </div>
            <div>
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </div>
    </form>
    <div class="flex-grow-1">
        <textarea class="form-control h-100" readonly id="result"></textarea>
    </div>
</div>

<script>
    const form = document.querySelector("#form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const response = await fetch('@Url.Action("ValidateTaxpayerTIN")', {
            method: "POST",
            body: JSON.stringify({
                tin: document.querySelector("#tin").value,
                nric: document.querySelector("#nric").value
            }),
            headers: {
                "Content-Type": "application/json"
            }
        });

        if (response.status == 200)
            document.querySelector("#result").value = JSON.stringify(await response.json(), null, 2);
    });
</script>