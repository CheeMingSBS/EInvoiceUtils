@{
    ViewData["Title"] = "Login As Intermediary";
}

<h1>Login As Intermediary</h1>
<div class="flex-grow-1 d-flex gap-4">
    <div class="flex-grow-1 d-flex flex-column gap-4">
        <form id="form">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label for="clientId">Client ID</label>
                    <input type="text" class="form-control" id="clientId" value="d6640527-32ff-42b8-8b73-8805169476d5" />
                </div>
                <div>
                    <label for="clientSecret">Client Secret</label>
                    <input type="text" class="form-control" id="clientSecret" value="720fdedd-8d3f-4222-b356-e2dd1332e951" />
                </div>
                <div>
                    <label for="onBehalfOf">On Behalf Of</label>
                    <input type="text" class="form-control" id="onBehalfOf" value="C21506779070" />
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <div id="result" class="fw-bold"></div>
                </div>
            </div>
        </form>
    </div>
    <div class="flex-grow-1 d-flex flex-column">
        <textarea class="form-control flex-grow-1" readonly id="output"></textarea>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $("#form").on("submit", (e) => {
        e.preventDefault();

        $.ajax({
            url: '@Url.Action("LoginAsIntermediary")',
            method: "POST",
            data: {
                clientId: $("#clientId").val(),
                clientSecret: $("#clientSecret").val(),
                onBehalfOf: $("#onBehalfOf").val()
            },
            success: function(data, textStatus, jqXHR) {
                $("#output").val(JSON.stringify(data, null, 2));

                if (jqXHR.status == 200)
                    $("#result").text("Success! ✅")
                else
                    $("#result").text("Failed! ❌")
            }
        });
    });
</script>