@{
    ViewData["Title"] = "Login As Intermediary";
}

<h1>Login As Intermediary</h1>
<div class="d-flex flex-column gap-4 h-100">
    <form id="form">
        <div class="d-flex flex-column gap-2">
            <div>
                <label for="clientId">Client ID</label>
                <input type="text" class="form-control w-50" id="clientId" value="d6640527-32ff-42b8-8b73-8805169476d5" />
            </div>
            <div>
                <label for="clientSecret">Client Secret</label>
                <input type="text" class="form-control w-50" id="clientSecret" value="720fdedd-8d3f-4222-b356-e2dd1332e951" />
            </div>
            <div>
                <label for="onBehalfOf">On Behalf Of</label>
                <input type="text" class="form-control w-50" id="onBehalfOf" value="C21506779070" />
            </div>
            <div>
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </div>
    </form>
    <div class="flex-grow-1">
        <textarea class="form-control h-100" readonly id="result"></textarea>
    </div>
</div>

<script>
    const form = document.querySelector("#form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const response = await fetch('@Url.Action("LoginAsIntermediary")', {
            method: "POST",
            body: JSON.stringify({
                clientId: document.querySelector("#clientId").value,
                clientSecret: document.querySelector("#clientSecret").value,
                onBehalfOf: document.querySelector("#onBehalfOf").value
            }),
            headers: {
                "Content-Type": "application/json"
            }
        });

        if (response.status == 200)
            document.querySelector("#result").value = JSON.stringify(await response.json(), null, 2);
    });
</script>