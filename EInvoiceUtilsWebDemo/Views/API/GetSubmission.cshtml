@{
    ViewData["Title"] = "Get Submission";
}

<h1>Get Submission</h1>
<div class="flex-grow-1 d-flex gap-4">
    <div class="flex-grow-1 d-flex flex-column gap-4">
        <form id="form">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label for="submissionUid">Submission UID</label>
                    <input type="text" class="form-control" id="submissionUid" value="ZN1JNBSKCSXFBNFTD78CZR2M10" />
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <button type="submit" class="btn btn-primary">Retrieve</button>
                    <div id="result" class="fw-bold"></div>
                </div>
            </div>
        </form>
    </div>
    <div class="flex-grow-1 d-flex flex-column">
        <textarea class="form-control flex-grow-1" readonly id="output"></textarea>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $("#form").on("submit", (e) => {
        e.preventDefault();

        $.ajax({
            url: '@Url.Action("GetSubmission")',
            method: "POST",
            data: {
                submissionUid: $("#submissionUid").val(),
            },
            success: function(data, textStatus, jqXHR) {
                $("#output").val(JSON.stringify(data, null, 2));

                if (jqXHR.status == 200)
                    $("#result").text("Success! ✅")
                else
                    $("#result").text("Failed! ❌")
            }
        });
    });
</script>